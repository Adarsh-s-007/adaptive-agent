# Backend (server-side only; never put these in a VITE_ variable)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/projectpulse
APP_ACCESS_TOKEN=change-me-long-random-string
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
GROQ_API_KEY=
LLM_MODEL_LARGE=openai/gpt-oss-120b
LLM_MODEL_SMALL=openai/gpt-oss-20b
CORS_ORIGIN=http://localhost:5173
DEMO_MODE=true
HINDSIGHT_FORCE_OFFLINE=false

# Frontend (frontend/.env.local)
VITE_API_BASE_URL=http://localhost:8000

# MCP server (projectpulse-mcp)
PROJECTPULSE_API_URL=http://localhost:8000
PROJECTPULSE_PROJECT_ID=
