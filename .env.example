# ProjectPulse server configuration. Copy to .env (gitignored) and fill in. Never commit secrets.

# --- Storage ---------------------------------------------------------------
# SQLite for local development; PostgreSQL / Supabase (pooled URL) in production:
#   postgresql+psycopg://user:password@host:6543/postgres?sslmode=require
DATABASE_URL=sqlite:///./projectpulse-demo.db

# --- Hindsight Cloud (required for memory) ---------------------------------
HINDSIGHT_API_KEY=
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
# Demonstrate honest degradation without breaking anything (DEMO_MODE only):
HINDSIGHT_FORCE_OFFLINE=false

# --- LLM: Groq or any OpenAI-compatible endpoint ---------------------------
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL_LARGE=openai/gpt-oss-120b
LLM_MODEL_SMALL=openai/gpt-oss-20b

# --- API surface -----------------------------------------------------------
# Shared bearer token for deployed instances (empty = open, local dev only).
APP_ACCESS_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://localhost:5176
# Enables /admin/* (seed, reset, force-offline). Keep false outside demos.
DEMO_MODE=true
LLM_RATE_LIMIT_PER_MINUTE=30
LOG_LEVEL=INFO

# --- Governance ------------------------------------------------------------
REVIEW_DUE_DAYS=180
RETRY_WORKER_INTERVAL_SECONDS=30
RETRY_MAX_ATTEMPTS=8

# --- Frontend (Vite) -------------------------------------------------------
# Only needed when the API is not served from the same origin / dev proxy.
VITE_API_BASE_URL=
