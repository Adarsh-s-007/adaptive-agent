#!/usr/bin/env python3
"""Block commits that touch files outside your ownership.

Enable once:  git config core.hooksPath scripts/dev/hooks
Set your id:  export PP_OWNER=P3
Bypass (owner-approved contract change only): PP_OWNER=ANY git commit ...
"""

import os
import subprocess
import sys
from pathlib import Path

root = Path(subprocess.check_output(["git", "rev-parse", "--show-toplevel"], text=True).strip())
me = os.environ.get("PP_OWNER", "").upper()
if not me:
    sys.exit("pre-commit: set PP_OWNER (P1..P6). See OWNERSHIP.md.")
if me == "ANY":
    sys.exit(0)

rules = []
for line in (root / "scripts/dev/ownership.txt").read_text().splitlines():
    if not line.strip() or line.lstrip().startswith("#"):
        continue
    parts = line.split()
    rules.append(("", parts[0]) if len(parts) == 1 else (parts[0], parts[1]))

staged = subprocess.check_output(
    ["git", "diff", "--cached", "--name-only", "--diff-filter=ACMRD"], text=True, cwd=root
).split()
bad = []
for path in staged:
    owner = next((o for p, o in rules if path.startswith(p)), "P1")
    if owner not in (me, "ALL"):
        bad.append(f"  {path}  (owner {owner})")
if bad:
    sys.exit("pre-commit: you are " + me + " but staged files you don't own:\n" + "\n".join(bad))
